# health-monitor configuration — copy to config.env and edit.
#
#   cp config.example.env config.env
#
# Every value can also be supplied as an environment variable, which wins over
# the file. Point HEALTH_MONITOR_CONFIG elsewhere to use a different file.
#
# config.env is git-ignored. Nothing here is a secret — the Home Assistant token
# is minted inside the container from its own refresh token and never written to
# disk — but the values are specific to your installation.

# Name of the Home Assistant Docker container to exec into.
HA_CONTAINER=homeassistant

# Home Assistant script entity that delivers the alert, WITHOUT the "script."
# prefix. It is called as: script.<HA_ALERT_SCRIPT>
# The script receives: {source, severity, message}
# Deduplication, phone push and quiet hours are that script's job, not this tool's.
HA_ALERT_SCRIPT=persistent_notification_alert

# Value passed as "source" so the receiving script can attribute the alert.
ALERT_SOURCE_ENTITY=sensor.health_monitor

# Log window handed to check.sh (journalctl --since syntax).
CHECK_WINDOW=24h
